# Copier en .env puis adapter. Ne jamais versionner .env.
# URL publique finale, sans slash final.
# Exemple : PUBLIC_BASE_URL=https://tableau-libre.mondomaine.fr
PUBLIC_BASE_URL=

# Mettre 1 derrière HTTPS (reverse proxy).
COOKIE_SECURE=

# Mettre 1 uniquement derrière un reverse proxy de confiance.
TRUST_PROXY=

# Comptes promus administrateurs (séparés par des virgules).
# Le premier compte créé est admin de toute façon.
ADMIN_EMAILS=

# Laisser vide pour générer une clé dans data/.secret.
SECRET_KEY=

# Mot de passe global optionnel du lecteur public.
ACCESS_PASSWORD=

# Durée d'inactivité d'une session publique (heures).
PUBLIC_TTL_HOURS=4

# Quotas et limites.
MAX_PUBLIC_BYTES=5368709120
PUBLIC_MAX_FILES=20
MAX_FILES=200
MAX_CACHE=64
DEFAULT_QUOTA_BYTES=2147483648

# Au-delà de cette taille de dépôt (octets), les feuilles sont rendues à la demande.
LAZY_BYTES=524288000

# Fond de carte MapLibre.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
